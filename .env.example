# The scraper needs no credentials. Everything here is optional.

# Jina Reader (optional, but the only thing that gets past an anti-bot
# interstitial). The last extraction tier: it refetches the page through
# r.jina.ai as HTML and re-runs the normal extractors over it. Measured
# against a Cloudflare-challenged source from a blocked network, a direct GET
# yielded 0 events and this yielded 31. Anonymous requests are unreliably
# blocked by IP reputation, so the tier is skipped entirely unless a key is
# set. In CI it comes from the JINA_API_KEY repository secret.
# JINA_API_KEY=your_jina_key_here

# Proxy (optional)
# Some sources refuse datacenter IPs outright - Eventbrite answers a GitHub
# runner with HTTP 405 - and only a residential proxy gets past that. The
# scraper's HTTP session picks this up with no code change.
# HTTPS_PROXY=http://user:pass@residential-proxy:port

# CloakBrowser (optional)
# The rendered-DOM tier, used when plain HTTP returns a bot challenge or
# nothing parseable. Works without a licence; the key only pins a newer binary.
# CLOAKBROWSER_LICENSE_KEY=optional_pro_license_key_for_latest_binary
# CLOAKBROWSER_PROXY=http://user:pass@residential-proxy:port

# Logging
LOG_LEVEL=INFO
