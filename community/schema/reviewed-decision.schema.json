{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsonlord.github.io/event-scraper-github-actions/community/schema/reviewed-decision.schema.json",
  "title": "Community weekly review decisions",
  "description": "The human editorial handoff. One file per issue week, referencing candidate events by their stable event_id.",
  "type": "object",
  "required": ["issue_week_start", "decisions"],
  "additionalProperties": true,
  "properties": {
    "issue_week_start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "reviewed_by": { "type": ["string", "null"] },
    "reviewed_at": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "decision"],
        "additionalProperties": true,
        "properties": {
          "event_id": { "type": "string", "pattern": "^ce-[0-9a-f]{24}$" },
          "decision": { "enum": ["approved", "rejected"] },
          "note": { "type": ["string", "null"] },
          "corrections": {
            "type": "object",
            "description": "Editorial corrections applied on promotion, e.g. a corrected title or price.",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
